    "선결정": {
        "word": "선결정",
        "hanja": "先決定",
        "sound": "선결정",
        "category": "개념 이해형",
        "type": "개념 이해형",
        "brief": "사건이나 행동이 일어나기 전에 이미 그 결과가 정해져 있음",
        "definition": "미리 결정함. 또는 그렇게 됨. (표준국어대사전)",
        "hanjaBreakdown": [
            {
                "character": "先",
                "hun": "먼저",
                "sound": "선",
                "meaning": "먼저, 앞서서"
